{
  "$schema": "https://opencode.ai/config.json",
  "model": "colab-g4/pennyroyal",
  "small_model": "colab-g4/pennyroyal",
  "provider": {
    "colab-g4": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Colab G4 / Pennyroyal",
      "options": {
        "baseURL": "{env:COLAB_BASE_URL}",
        "apiKey": "{env:COLAB_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "pennyroyal": {
          "name": "Qwen Flash-Next NVFP4 (Colab G4)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 524288,
            "output": 131072
          },
          "options": {
            "temperature": 1,
            "top_p": 0.95,
            "top_k": 20,
            "presence_penalty": 0,
            "repetition_penalty": 1,
            "max_tokens": 131072,
            "chat_template_kwargs": {
              "enable_thinking": true,
              "preserve_thinking": true,
              "reasoning_effort": "medium"
            }
          },
          "variants": {
            "off": {
              "chat_template_kwargs": {
                "enable_thinking": false,
                "preserve_thinking": true,
                "reasoning_effort": "none"
              }
            },
            "medium": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "preserve_thinking": true,
                "reasoning_effort": "medium"
              }
            },
            "xhigh": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "preserve_thinking": true,
                "reasoning_effort": "xhigh"
              }
            },
            "none": {
              "disabled": true
            },
            "minimal": {
              "disabled": true
            },
            "low": {
              "disabled": true
            },
            "high": {
              "disabled": true
            },
            "max": {
              "disabled": true
            }
          }
        }
      }
    }
  }
}
